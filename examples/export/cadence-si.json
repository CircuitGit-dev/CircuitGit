{
  "schema": "ic.netlist.export.v1",
  "transport": "ssh",
  "ssh_target": "eda-host",
  "cds_lib": "/path/to/restored/project/cds.lib",
  "si_env_template": "cadence-generated-si.env",
  "library": "your_library",
  "cell": "your_testbench",
  "view": "schematic",
