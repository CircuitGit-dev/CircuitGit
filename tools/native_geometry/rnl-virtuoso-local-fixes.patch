+++ b/cmd/rnl-virtuoso/va_function_scope_test.go
@@ -0,0 +1,15 @@
+package main
+import("testing";"reflect")
+func TestFunctionArgumentsAreNotModulePorts(t *testing.T){
+ src := `module clamp(P,N,VDD,VSS); inout P,N,VDD,VSS; electrical P,N,VDD,VSS;
+ analog function real positive; input x,eps; real x,eps; begin positive=x; end endfunction
+ analog function real other; input P,eps; real P,eps; begin other=P; end endfunction
+ endmodule`
+ want:=[]string{"P","N","VDD","VSS"}
+ if got:=interfaces(src)["clamp"];!reflect.DeepEqual(got,want){t.Fatalf("%v",got)}
+}
+func TestModulePortFailuresRemainRejected(t *testing.T){
+ for _,src:=range []string{`module x(A); input A,B; analog function real f; input x; endfunction endmodule`,`module x(A); input A; analog function real f; input x; endmodule`}{
+  func(){defer func(){if recover()==nil{t.Errorf("accepted invalid interface %s",src)}}();interfaces(src)}()
+ }
+}
--- /dev/null
+++ b/cmd/rnl-virtuoso/ignored_figures.go
@@ -0,0 +1,33 @@
+package main
+
+import "strings"
+
+// Read-only recovery from the original EDIF. Explicitly ignored instruments
+// are figures, never electrical instances; their terminals become visual dots.
+func ignoredFigures(drawing string, scale float64) []map[string]any {
+ cells, ordered := readEDIF(drawing)
+ rows := []map[string]any{}
+ for _, c := range ordered {
+  seen := stringSet{}
+  for _, ins := range c.Instances {
+   if ins.Action != "ignore" { continue }
+   if ins.Bundle != "" && seen[ins.Bundle] { continue }
+   if ins.Bundle != "" { seen[ins.Bundle] = true }
+   master := cells[ins.Master]
+   if master == nil || !master.Symbol.group { fail("Ignored figure has no native symbol: %s/%s/%s",c.Library,c.Name,ins.Name) }
+   terms := map[string]string{}
+   for id, name := range master.Ports { terms[id] = quote(name) }
+   notes := []string{}
+   index := strconvI(len(rows))
+   sym := "%ignored_symbol_"+index
+   definition := symbolDefinition(master,sym,terms,scale,&notes)
+   definition = rx(`@PIN\(terminal=[^\n]*?\)`).ReplaceAllString(definition,`@CIRCLE(radius=0.12)`)
+   name := ins.Name
+   if ins.Bundle != "" { name = ins.BundleName }
+   usage := "%ignored_"+index
+   records := []string{definition,usage+" = $FIGURE @ATTACH "+pt(scaled(ins.XY,scale))+" => @SET-SYMBOL "+sym+" => @ORIENT("+quote(ins.Orient)+")",usage+" @TEXT("+quote(name)+", key=\"name\")",usage+" @TEXT("+quote(master.Name)+", key=\"model\")"}
+   rows=append(rows,map[string]any{"library":c.Library,"cell":c.Name,"name":name,"master_library":master.Library,"master_cell":master.Name,"xy":scaled(ins.XY,scale),"orientation":ins.Orient,"records":strings.Join(records,";\n"),"notes":notes,"electrical":false,"terminal_rendering":"visual dots at native coordinates; no electrical terminals"})
+  }
+ }
+ return rows
+}
