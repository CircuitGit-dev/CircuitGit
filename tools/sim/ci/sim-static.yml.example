name: simulation-static
on:
  pull_request:
    paths: ['tools/sim/**', 'tools/workbench/ic_sim.py', '.github/workflows/sim-static.yml']
  workflow_dispatch:
permissions:
  contents: read
jobs:
  static:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: '3.11'
      - name: Offline runner and shell tests
        run: python -B tools/sim/test_ic_sim.py
      - name: Offline generic bundle hash plan
        run: |
          python -B tools/workbench/ic_sim.py --site config/site.example.json plan --bundle tools/sim/fixtures/bundle.json
