name: simulation-static
on:
  pull_request:
    paths: ['tools/sim/**', '.github/workflows/sim-static.yml']
  workflow_dispatch:
permissions:
  contents: read
jobs:
  static:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: '3.11'
      - name: Offline runner and shell tests
        working-directory: tools/sim
        run: python -B test_ic_sim.py
      - name: Offline generic bundle hash plan
        working-directory: tools/sim
        run: |
          python -B ic_sim.py --site site.local.example.json plan --bundle fixtures/bundle.json
