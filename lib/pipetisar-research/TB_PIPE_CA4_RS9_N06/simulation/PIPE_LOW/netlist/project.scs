// Library name: 2026_PIPETISAR_RESEARCH
// Cell name: PIPE_OTA_Diff_Ideal
// View name: schematic
subckt PIPE_OTA_Diff_Ideal Vcmo Vdd Vin Vinb Vout Voutb
parameters gm=1 gm_id=20 Gain=1e8
    I0 (Vdd 0) isource dc=gm/gm_id type=dc
    E4 (Vinb net023 0 0) vcvs gain=0
    R0 (Voutb Vcmo_int) resistor r=Gain/gm isnoisy=no
    R4 (Vcmo_int Vout) resistor r=Gain/gm isnoisy=no
    G0 (Voutb Vout Vin net023) vccs gm=gm/2
    G1 (Voutb 0 Vcmo_int Vcmo) vccs gm=20*gm
    G3 (Vout 0 Vcmo_int Vcmo) vccs gm=20*gm
ends PIPE_OTA_Diff_Ideal
// End of subcircuit definition.

